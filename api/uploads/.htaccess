# Protect uploads directory from direct access to PHP files
<FilesMatch "\.(php|php3|php4|php5|phtml)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Prevent directory listing
Options -Indexes

# Allow only specific file types to be accessed
<FilesMatch "\.(pdf|doc|docx|xls|xlsx|jpg|jpeg|png|gif|zip|rar|7z|dwg|dxf|step|stp|iges|igs|stl|obj)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>
